rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Website content is publicly readable by anyone (so Haseena can view it without logging in)
    // Only authenticated admin users can create, update, or delete content
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Proposal responses: Public users can submit (create) a response, but only admin can read all responses
    match /proposalResponses/{responseId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
      allow update: if false; // immutable record of her response
    }
    
    // Default rule: block all other access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
